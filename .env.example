# Required. The Studio (/admin) password, 12+ characters. The server refuses to start in production without it.
ADMIN_PASSWORD=

# Optional. Signs admin session cookies. If unset, a random key is generated once and stored in the
# database (or kept in memory for local development without a database). Never derived from the password.
SESSION_SECRET=

# Optional locally, required on Vercel/serverless. Postgres connection string for CMS storage
# (draft, published page, version history). If unset, data/cms.json is used.
# Neon / Supabase: use the pooled connection string and include ?sslmode=require
DATABASE_URL=

# Optional. WhatsApp number for "#contact" CTAs (click-to-chat). International format, e.g. 919876543210
# (a 10-digit Indian mobile number also works). If unset, those buttons keep their #contact anchor.
CONTACT_WHATSAPP=

# Optional. Vercel Blob token for listing photos. Added automatically when you connect a Blob store
# to the Vercel project. Without it, photos are saved to data/uploads locally (development only).
BLOB_READ_WRITE_TOKEN=

# Optional. Set to "false" to start with no sample listings on a new database.
SEED_SAMPLE_LISTINGS=

# Optional. Search engines are blocked until this is "true" (the demo runs on sample data).
ALLOW_INDEXING=
# Public site address for canonical links, link previews and the sitemap, e.g. https://nivaas.in
# (on Vercel it defaults to the project's production domain)
SITE_URL=
