# Required. The Studio (/admin) password. The server refuses to start in production without it.
ADMIN_PASSWORD=

# Optional. Signs admin session cookies. If unset, a key derived from ADMIN_PASSWORD is used.
SESSION_SECRET=

# Optional locally, required on Vercel/serverless. Postgres connection string for CMS storage
# (draft, published page, version history). If unset, data/cms.json is used.
# Neon / Supabase: use the pooled connection string and include ?sslmode=require
DATABASE_URL=
